

<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
  <meta charset="UTF-8">
  <title>ایران‌پوش | کاتالوگ استودیو</title>
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Tahoma, sans-serif;
    }

    body {
      background: #070709;
      color: #fff;
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 30px 16px;
      min-height: 100vh;
    }

    /* نوار تعویض اسلایدها */
    .tabs-wrapper {
      display: flex;
      gap: 10px;
      margin-bottom: 24px;
      background: #141418;
      padding: 6px;
      border-radius: 12px;
      border: 1px solid rgba(255,255,255,0.08);
      flex-wrap: wrap;
      justify-content: center;
    }

    .tab-btn {
      background: transparent;
      color: #888;
      border: none;
      padding: 10px 18px;
      border-radius: 8px;
      font-size: 13px;
      font-weight: 700;
      cursor: pointer;
      transition: 0.2s;
    }

    .tab-btn.active {
      background: #E55334;
      color: #fff;
    }

    /* کانتینر اصلی اسلاید با نسبت ۴:۵ اینستاگرام */
    .slide-frame {
      width: 440px;
      height: 550px;
      border-radius: 16px;
      position: relative;
      overflow: hidden;
      display: none;
      box-shadow: 0 30px 90px rgba(0,0,0,0.9);
      background: #000;
    }

    .slide-frame.active {
      display: block;
    }

    /* لایه‌های مشترک */
    .top-meta {
      position: absolute;
      top: 24px;
      right: 24px;
      left: 24px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      z-index: 20;
    }

    .brand-title {
      font-size: 16px;
      font-weight: 900;
      letter-spacing: -0.5px;
    }

    .slide-index {
      font-size: 28px;
      font-family: Georgia, serif;
      font-weight: 700;
      opacity: 0.9;
    }

    .bottom-meta {
      position: absolute;
      bottom: 24px;
      right: 24px;
      left: 24px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      z-index: 20;
      font-size: 11px;
      font-family: monospace;
      color: rgba(255,255,255,0.7);
    }

    /* ==============================================
       اسلاید ۱: معرفی محصول با عکس واقعی مدل
       ============================================== */
    #slide-1 {
      background: #EFECE6;
      color: #111;
    }

    #slide-1 .bg-model {
      position: absolute;
      top: 0;
      left: 0;
      width: 58%;
      height: 100%;
      background: url('https://images.unsplash.com/photo-1539571696357-5a69c17a67c6?auto=format&fit=crop&w=800&q=80') center/cover no-repeat;
      filter: contrast(1.05);
    }

    #slide-1 .info-panel {
      position: absolute;
      top: 0;
      right: 0;
      width: 46%;
      height: 100%;
      background: #EFECE6;
      padding: 80px 20px 60px 16px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      z-index: 10;
      box-shadow: -15px 0 35px rgba(0,0,0,0.1);
    }

    .product-badge {
      background: #111;
      color: #D4AF37;
      font-size: 9px;
      font-weight: 800;
      padding: 4px 8px;
      border-radius: 3px;
      display: inline-block;
      margin-bottom: 8px;
      letter-spacing: 1px;
    }

    .prod-h1 {
      font-size: 20px;
      font-weight: 900;
      line-height: 1.25;
      margin-bottom: 10px;
    }

    .prod-tags {
      display: flex;
      flex-direction: column;
      gap: 6px;
      font-size: 11px;
      margin-bottom: 20px;
    }

    .prod-tags span {
      background: rgba(0,0,0,0.05);
      padding: 4px 8px;
      border-radius: 4px;
      border-right: 2px solid #D4AF37;
    }

    .price-now {
      font-size: 20px;
      font-weight: 900;
      color: #E55334;
    }

    .price-old {
      font-size: 12px;
      text-decoration: line-through;
      color: #888;
    }

    .quick-cta {
      background: #111;
      color: #fff;
      padding: 10px;
      border-radius: 20px;
      font-size: 11px;
      font-weight: 700;
      text-align: center;
      margin-top: 10px;
    }

    /* ==============================================
       اسلاید ۲: جشنواره و تخفیف با اورلپ سینمایی
       ============================================== */
    #slide-2 {
      background: #000;
      color: #fff;
    }

    #slide-2 .bg-camp {
      position: absolute;
      inset: 0;
      background: url('https://images.unsplash.com/photo-1490481651871-ab68de25d43d?auto=format&fit=crop&w=900&q=80') center/cover no-repeat;
      opacity: 0.55;
      filter: grayscale(40%) contrast(1.1);
    }

    #slide-2 .gradient-mask {
      position: absolute;
      inset: 0;
      background: linear-gradient(180deg, rgba(0,0,0,0.2) 0%, rgba(0,0,0,0.85) 75%, #000 100%);
    }

    .camp-center {
      position: absolute;
      bottom: 70px;
      right: 24px;
      left: 24px;
      z-index: 10;
    }

    .huge-pct {
      font-family: Georgia, serif;
      font-size: 96px;
      font-weight: 900;
      line-height: 0.85;
      color: #fff;
      margin-bottom: 8px;
      letter-spacing: -4px;
    }

    .camp-h1 {
      font-size: 24px;
      font-weight: 900;
      margin-bottom: 6px;
    }

    .camp-p {
      font-size: 12px;
      color: #ccc;
      line-height: 1.5;
      margin-bottom: 16px;
    }

    .voucher-chip {
      background: rgba(255,255,255,0.12);
      backdrop-filter: blur(12px);
      border: 1px solid rgba(255,255,255,0.2);
      border-radius: 8px;
      padding: 10px 16px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .voucher-code {
      font-family: monospace;
      font-size: 20px;
      font-weight: 900;
      color: #E55334;
      letter-spacing: 2px;
    }

    /* ==============================================
       اسلاید ۳: کپسول استایل ۳ حالته (The 3-Way Look)
       ============================================== */
    #slide-3 {
      background: #0E1015;
      color: #fff;
    }

    .guide-cards {
      position: absolute;
      top: 80px;
      bottom: 60px;
      right: 24px;
      left: 24px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      z-index: 10;
    }

    .style-row {
      display: flex;
      gap: 14px;
      align-items: center;
      background: #171922;
      border: 1px solid rgba(255,255,255,0.06);
      border-radius: 10px;
      padding: 10px;
    }

    .style-thumb {
      width: 75px;
      height: 95px;
      border-radius: 6px;
      background-size: cover;
      background-position: center;
      flex-shrink: 0;
    }

    .style-text h3 {
      font-size: 14px;
      font-weight: 800;
      margin-bottom: 4px;
      color: #D4AF37;
    }

    .style-text p {
      font-size: 11px;
      color: #B5B9C4;
      line-height: 1.5;
    }

    /* ==============================================
       اسلاید ۴: مانیفست کال‌تواکشن و خرید
       ============================================== */
    #slide-4 {
      background: #050608;
      color: #fff;
      text-align: center;
    }

    #slide-4 .bg-model-cta {
      position: absolute;
      inset: 0;
      background: url('https://images.unsplash.com/photo-1483985988355-763728e1935b?auto=format&fit=crop&w=900&q=80') center/cover no-repeat;
      opacity: 0.35;
      filter: contrast(1.15);
    }

    .cta-body {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      padding: 30px;
      z-index: 10;
      background: radial-gradient(circle, rgba(0,0,0,0.4) 0%, rgba(0,0,0,0.9) 80%);
    }

    .cta-title {
      font-size: 26px;
      font-weight: 900;
      line-height: 1.35;
      margin-bottom: 12px;
    }

    .cta-desc {
      font-size: 12px;
      color: #A0A5B5;
      line-height: 1.6;
      max-width: 280px;
      margin-bottom: 24px;
    }

    .cta-pill-btn {
      background: #fff;
      color: #000;
      padding: 12px 32px;
      border-radius: 26px;
      font-size: 13px;
      font-weight: 900;
      display: inline-block;
      box-shadow: 0 10px 30px rgba(255,255,255,0.25);
    }
  </style>
</head>
<body>

  <!-- تب‌های انتخاب اسلاید -->
  <div class="tabs-wrapper">
    <button class="tab-btn active" onclick="switchSlide(1, this)">اسلاید ۱: معرفی لباس</button>
    <button class="tab-btn" onclick="switchSlide(2, this)">اسلاید ۲: حراج پاییزه</button>
    <button class="tab-btn" onclick="switchSlide(3, this)">اسلاید ۳: کپسول استایل</button>
    <button class="tab-btn" onclick="switchSlide(4, this)">اسلاید ۴: خرید و دایرکت</button>
  </div>

  <!-- اسلاید ۱ -->
  <div class="slide-frame active" id="slide-1">
    <div class="top-meta" style="color: #111;">
      <span class="brand-title">ایران‌پوش</span>
      <span class="slide-index">01</span>
    </div>

    <div class="bg-model"></div>

    <div class="info-panel">
      <div>
        <span class="product-badge">NEW COLLECTION</span>
        <h1 class="prod-h1">بارانی کتان دوخت راسته</h1>
        <div class="prod-tags">
          <span>کتان ۱۰۰٪ ضدآب یزد</span>
          <span>برش آزاد (Oversized)</span>
          <span>آستر ابریشم طبیعی</span>
        </div>
      </div>

      <div>
        <div>
          <span class="price-now">۲,۸۵۰,۰۰۰ تومان</span>
          <span class="price-old">۳,۴۰۰,۰۰۰</span>
        </div>
        <div class="quick-cta">مشاهده و خرید</div>
      </div>
    </div>

    <div class="bottom-meta" style="color: #333;">
      <span>@IRANPOOSH</span>
      <span>EDITION 2026</span>
    </div>
  </div>

  <!-- اسلاید ۲ -->
  <div class="slide-frame" id="slide-2">
    <div class="bg-camp"></div>
    <div class="gradient-mask"></div>

    <div class="top-meta">
      <span class="brand-title">ایران‌پوش</span>
      <span class="slide-index" style="color: #E55334;">02</span>
    </div>

    <div class="camp-center">
      <div class="huge-pct">-45%</div>
      <h2 class="camp-h1">حراج خصوصی کالکشن پاییز</h2>
      <p class="camp-p">تخفیف محدود روی تمام پالتوها و بارانی‌های دست‌دوز استودیو ایران‌پوش.</p>

      <div class="voucher-chip">
        <div>
          <div style="font-size: 10px; color: #888;">کد تخفیف:</div>
          <div class="voucher-code">STUDIO45</div>
        </div>
        <div style="font-size: 11px; color: #E55334; font-weight: 700;">مهلت ۷۲ ساعت</div>
      </div>
    </div>

    <div class="bottom-meta">
      <span>@IRANPOOSH</span>
      <span>LIMITED DROP</span>
    </div>
  </div>

  <!-- اسلاید ۳ -->
  <div class="slide-frame" id="slide-3">
    <div class="top-meta">
      <span class="brand-title">ایران‌پوش</span>
      <span class="slide-index">03</span>
    </div>

    <div class="guide-cards">
      <h2 style="font-size: 18px; font-weight: 900; margin-bottom: 8px;">۳ فرمول ست کردن یک بارانی</h2>

      <div class="style-row">
        <div class="style-thumb" style="background-image: url('https://images.unsplash.com/photo-1515886657613-9f3515b0c78f?auto=format&fit=crop&w=300&q=80');"></div>
        <div class="style-text">
          <h3>استایل اداری و رسمی</h3>
          <p>ترکیب با شلوار راسته زغالی، شومیز سفید یقه انگلیسی و کفش لوفر چرم.</p>
        </div>
      </div>

      <div class="style-row">
        <div class="style-thumb" style="background-image: url('https://images.unsplash.com/photo-1552374196-1ab2a1c593e8?auto=format&fit=crop&w=300&q=80');"></div>
        <div class="style-text">
          <h3>کژوال شهری (Street Chic)</h3>
          <p>ست با هودی اورسایز کرم، جین نیم‌بگ و اسنیکرز لژدار.</p>
        </div>
      </div>

      <div class="style-row">
        <div class="style-thumb" style="background-image: url('https://images.unsplash.com/photo-1529139574466-a303027c1d8b?auto=format&fit=crop&w=300&q=80');"></div>
        <div class="style-text">
          <h3>مونوکروم شبانه</h3>
          <p>ترکیب سرتاسر مشکی با بوت چرم ساق‌دار و اکسسوری طلایی.</p>
        </div>
      </div>
    </div>

    <div class="bottom-meta">
      <span>@IRANPOOSH</span>
      <span>STYLE GUIDE</span>
    </div>
  </div>

  <!-- اسلاید ۴ -->
  <div class="slide-frame" id="slide-4">
    <div class="bg-model-cta"></div>

    <div class="top-meta">
      <span class="brand-title">ایران‌پوش</span>
      <span class="slide-index">04</span>
    </div>

    <div class="cta-body">
      <span style="color: #D4AF37; font-size: 11px; letter-spacing: 2px; font-family: monospace; margin-bottom: 8px;">FASHION FORWARD</span>
      <h2 class="cta-title">استایل متمایز خود را در این فصل پیدا کنید</h2>
      <p class="cta-desc">کلمه <strong>«بارانی»</strong> را کامنت کنید تا جدول دقیق سایزبندی و لینک مستقیم خرید اختصاصی برایتان ارسال شود.</p>
      <div class="cta-pill-btn">ارسال دایرکت خودکار ←</div>
    </div>

    <div class="bottom-meta">
      <span>@IRANPOOSH</span>
      <span>IRANPOOSH.COM</span>
    </div>
  </div>

  <script>
    function switchSlide(index, btn) {
      document.querySelectorAll('.slide-frame').forEach(el => el.classList.remove('active'));
      document.querySelectorAll('.tab-btn').forEach(el => el.classList.remove('active'));

      document.getElementById('slide-' + index).classList.add('active');
      btn.classList.add('active');
    }
  </script>
</body>
</html>

