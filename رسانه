<tr><td>صفحه ۳</td><td class="c">۲۰۰</td><td>کاغذ ۱۳۵ گرم</td></tr>
<tr><td>داخل روی جلد</td><td class="c">۲۲۰</td><td>مقوا ۲۵۰ گرم</td></tr>
<tr><td>پوستر پشت جلد</td><td class="c">۲۱۰</td><td>دو صفحه بزرگ داخل پشت جلد</td></tr>
<tr><td>پوستر روی جلد</td><td class="c">۲۹۰</td><td>دو صفحه بزرگ داخل روی جلد</td></tr>
