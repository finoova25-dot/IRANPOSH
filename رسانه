<script>
(function(){
  var s=[].slice.call(document.querySelectorAll('.slide')),i=0,
      dots=document.getElementById('dots'),cnt=document.getElementById('cnt'),
      pv=document.getElementById('prev'),nx=document.getElementById('next');
  var fa=function(n){return String(n).replace(/\d/g,function(d){return '۰۱۲۳۴۵۶۷۸۹'[d]})};
  s.forEach(function(el,k){var b=document.createElement('button');b.className='dot';b.type='button';
    b.setAttribute('aria-label','اسلاید '+fa(k+1));b.onclick=function(){go(k)};dots.appendChild(b)});
  function go(n){
    i=Math.max(0,Math.min(s.length-1,n));
    s.forEach(function(el,k){el.classList.toggle('on',k===i)});
    [].forEach.call(dots.children,function(d,k){d.classList.toggle('on',k===i)});
    cnt.textContent=fa(i+1)+' از '+fa(s.length);
    pv.disabled=i===0;nx.disabled=i===s.length-1;
    document.body.classList.toggle('isdark',s[i].classList.contains('dark'));
    s[i].scrollTop=0;
    try{history.replaceState(null,'','#'+(i+1))}catch(e){}
  }
  pv.onclick=function(){go(i-1)};nx.onclick=function(){go(i+1)};
  document.addEventListener('keydown',function(e){
    var k=e.key;
    if(k==='ArrowLeft'||k==='PageDown'||k===' '){e.preventDefault();go(i+1)}
    else if(k==='ArrowRight'||k==='PageUp'){e.preventDefault();go(i-1)}
    else if(k==='Home'){go(0)}else if(k==='End'){go(s.length-1)}
  });
  var x0=null;
  document.addEventListener('touchstart',function(e){x0=e.touches[0].clientX},{passive:true});
  document.addEventListener('touchend',function(e){
    if(x0===null)return;var dx=e.changedTouches[0].clientX-x0;x0=null;
    if(Math.abs(dx)>70){go(dx<0?i+1:i-1)}
  });
  var h=parseInt(location.hash.slice(1),10);go(h>0?h-1:0);
})();
</script>
