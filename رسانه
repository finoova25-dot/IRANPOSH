<link href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@400;600;800&display=swap" rel="stylesheet">
<style>
:root{--p:#4B3475;--d:#2D1F4A;--l:#F4F1F8;--a:#6B4FA3;--w:#FBFAFD;--t:#EAE5F2;--r:#B3261E;--o:#B45309;--g:#157A3E;--m:#5B5470}
*{box-sizing:border-box;margin:0;padding:0}
html,body{height:100%}
body{font-family:'Vazirmatn',Tahoma,sans-serif;background:var(--l);color:var(--d);overflow:hidden;line-height:1.6}
.slide{position:absolute;inset:0;display:none;flex-direction:column;gap:clamp(12px,2.4vh,26px);padding:clamp(56px,9vh,96px) clamp(16px,6vw,110px) 84px;overflow-y:auto}
.slide.on{display:flex;animation:in .3s ease-out}
@keyframes in{from{opacity:0}to{opacity:1}}
@media (prefers-reduced-motion:reduce){.slide.on{animation:none}}
.dark{background:var(--d);color:var(--l)}
.logo{position:fixed;top:clamp(14px,3vh,28px);left:clamp(16px,4vw,56px);display:flex;gap:6px;align-items:center;color:var(--p);z-index:5;transition:color .3s}
body.isdark .logo{color:var(--l)}
.logo i{display:block;width:18px;height:18px;border-radius:9px;background:currentColor}
.logo i:last-child{width:48px}
h1{font-size:clamp(30px,5.4vw,70px);font-weight:800;line-height:1.25}
h2{font-size:clamp(24px,3.6vw,46px);font-weight:800;line-height:1.25;color:var(--p)}
.dark h2{color:var(--l)}
h3{font-size:clamp(17px,2vw,24px);font-weight:800}
p,td,th,li{font-size:clamp(14px,1.55vw,20px)}
.sub{color:#CFC6E3}
.row{display:flex;gap:16px;flex-wrap:wrap}
.card{flex:1 1 250px;background:var(--w);border-radius:18px;padding:20px 24px;display:flex;flex-direction:column;gap:8px}
.dark .card{background:#3F2E63}
.card.hi{background:var(--a);color:#fff}
.big{font-size:clamp(28px,4.2vw,56px);font-weight:800;line-height:1.2}
.tw{overflow-x:auto;border-radius:14px}
table{width:100%;border-collapse:collapse;background:var(--w)}
th{background:var(--p);color:#fff;font-weight:600}
th,td{padding:10px 14px;text-align:right;vertical-align:top}
tbody tr:nth-child(even){background:var(--t)}
td.c,th.c{text-align:center}
tr.sum td{background:#D9CFEA;font-weight:800}
.ok{color:var(--g);font-weight:800}.mid{color:var(--o);font-weight:800}.no{color:var(--r);font-weight:800}
.bars{display:flex;flex-direction:column;gap:10px;background:var(--w);border-radius:18px;padding:18px 24px}
.bar{display:grid;grid-template-columns:minmax(120px,22%) 1fr minmax(90px,16%);gap:12px;align-items:center}
.bar b{display:block;height:18px;border-radius:9px;background:var(--a);width:var(--v)}
.bar.hot b{background:var(--r)}
.note{background:#FEF3C7;color:#7A3E06;border-radius:14px;padding:14px 20px}
.flag{background:var(--p);color:#fff;border-radius:14px;padding:14px 20px}
.gates{display:flex;gap:0;flex-wrap:wrap}
.gate{flex:1 1 220px;padding:18px 22px;background:var(--w);border-top:6px solid var(--a);display:flex;flex-direction:column;gap:6px}
.gate:nth-child(2){border-color:var(--o)}.gate:nth-child(3){border-color:var(--r)}
.rules{display:flex;gap:12px;flex-wrap:wrap}
.rules p{flex:1 1 200px;border-radius:12px;padding:10px 14px;font-weight:600}
.rules .g{background:#D7EFDF;color:#0F5A2D}.rules .y{background:#FEF3C7;color:#7A3E06}.rules .r{background:#F8D9D6;color:#8A1C16}
.v{border-radius:18px;background:var(--w);padding:18px 22px;display:flex;flex-direction:column;gap:6px;flex:1 1 360px;border-right:8px solid var(--a)}
.v.go{border-color:var(--g)}.v.cond{border-color:var(--o)}.v.stop{border-color:var(--r)}
.src{color:var(--m);font-size:clamp(12px,1.2vw,15px)}
nav{position:fixed;bottom:0;left:0;right:0;height:64px;display:flex;align-items:center;gap:14px;padding:0 clamp(12px,4vw,56px);background:rgba(244,241,248,.94);border-top:1px solid #D9CFEA;z-index:6}
body.isdark nav{background:rgba(45,31,74,.94);border-color:#4B3475}
nav button{font:inherit;font-weight:600;border:0;border-radius:999px;padding:8px 18px;background:var(--p);color:#fff;cursor:pointer}
nav button:disabled{opacity:.35;cursor:default}
nav button:focus-visible,.dot:focus-visible{outline:3px solid #E8A33D;outline-offset:2px}
.dots{display:flex;gap:8px;flex:1;justify-content:center}
.dot{width:12px;height:12px;border-radius:6px;border:0;background:#B9AED3;cursor:pointer;padding:0}
.dot.on{width:34px;background:var(--a)}
.cnt{font-size:15px;color:var(--m);min-width:56px;text-align:center}
body.isdark .cnt{color:#CFC6E3}
@media print{body{overflow:visible}.slide{display:flex!important;position:static;page-break-after:always;min-height:100vh}nav,.logo{display:none}}
</style>
</head>
